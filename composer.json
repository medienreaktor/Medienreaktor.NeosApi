{
    "name": "medienreaktor/neos-api",
    "type": "neos-package",
    "description": "HTTP API for Neos, defined with neos/openapi and secured by Neos.OAuth",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "neos/flow": "^9.2",
        "neos/neos": "^9.2",
        "neos/media": "^9.2",
        "medienreaktor/neos-oauth": "^0.1",
        "behat/transliterator": "^1.5",
        "doctrine/dbal": "^3.8",
        "medienreaktor/neos-openapi-bundle": "^0.1"
    },
    "require-dev": {
        "neos/contentgraph-doctrinedbaladapter": "^9.2",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "~11.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "suggest": {
        "medienreaktor/neos-api-docs": "Swagger UI for the API on /api/docs"
    },
    "autoload": {
        "psr-4": {
            "Neos\\Api\\": "Classes/"
        }
    },
    "extra": {
        "neos": {
            "package-key": "Neos.Api"
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "neos/composer-plugin": true
        }
    },
    "scripts": {
        "lint:composer": "@composer validate --strict --no-check-lock",
        "lint:phpstan": "@php vendor/bin/phpstan analyse",
        "lint:phpcs": "./vendor/bin/phpcs --colors",
        "lint:phpcs:fix": "./vendor/bin/phpcbf --colors",
        "lint": [
            "@lint:composer",
            "@lint:phpcs",
            "@lint:phpstan"
        ]
    }
}
